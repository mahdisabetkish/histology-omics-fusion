/*
 * Where each process publishes its output. The layout under --outdir mirrors
 * the repository's own data/processed, runs/ and docs/, so results from a
 * Nextflow run can be dropped in place of a hand-run study.
 */

process {
    publishDir = [
        path   : { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode   : params.publish_dir_mode,
        enabled: false,
    ]

    withName: 'CHECK_DATA' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'SELECT_FEATURES' {
        publishDir = [
            path   : { params.outdir },
            mode   : params.publish_dir_mode,
            enabled: params.save_processed,
        ]
    }

    withName: 'PRETRAIN_SSL|TRAIN' {
        publishDir = [
            path: { "${params.outdir}/runs" },
            mode: params.publish_dir_mode,
        ]
    }

    // <tag>__eval_<split>/ becomes runs/<tag>/eval_<split>/, beside the
    // checkpoint it scored.
    withName: 'EVALUATE' {
        publishDir = [
            path  : { "${params.outdir}/runs/${meta.tag}" },
            mode  : params.publish_dir_mode,
            saveAs: { name -> name.replaceFirst(/^.*__/, '') },
        ]
    }

    withName: 'EXPORT_RESULTS' {
        publishDir = [
            path: { params.outdir },
            mode: params.publish_dir_mode,
        ]
    }
}
