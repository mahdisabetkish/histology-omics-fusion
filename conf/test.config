/*
 * Minimal end-to-end run on synthetic data: every stage and every row of the
 * run matrix, a couple of epochs each, on a CPU in a few minutes.
 *
 *   nextflow run . -profile test,docker
 *
 * Checks the wiring between stages, not the science. The numbers it produces
 * mean nothing.
 */

params {
    test             = true
    test_spots       = 400
    test_genes       = 400
    patch_size       = 64
    n_hvg            = 200
    min_spots        = 5

    epochs           = 2
    ssl_epochs       = 2
    ssl_batch_size   = 64
    train_extra_args = '--batch-size 32 --patience 2 --warmup 1'
    ssl_extra_args   = '--eval-every 1 --retrieval-gallery 256 --warmup 1'

    max_cpus         = 4
    max_memory       = '6.GB'
    max_time         = '1.h'
    outdir           = 'results-test'
}

process {
    withLabel: 'process_gpu|process_export|process_medium|process_data' {
        cpus   = { 2 }
        memory = { 3.GB }
    }
}
