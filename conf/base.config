/*
 * Resources per process label. The figures follow what the study needed on a
 * GTX 1080 Ti node; see slurm/ for the equivalent hand-written job scripts.
 *
 * A task killed for memory or time (exit 137-140, 143) is retried with a
 * larger allocation, up to twice. Any other failure stops the pipeline, so a
 * real bug is not hidden behind retries.
 */

process {
    cpus   = { 2 }
    memory = { 8.GB * task.attempt }
    time   = { 2.h * task.attempt }

    errorStrategy = { task.exitStatus in ((137..140) + 143) ? 'retry' : 'finish' }
    maxRetries    = 2

    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time,
    ]

    withLabel: 'process_single' {
        cpus   = { 1 }
        memory = { 4.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus   = { 4 }
        memory = { 16.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    // Download plus TIFF decoding and patch extraction. The download host, not
    // the bandwidth, sets the pace, hence the generous time limit.
    withLabel: 'process_data' {
        cpus   = { 8 }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
    // Network access is flaky rather than broken: retry any failure.
    withLabel: 'process_network' {
        errorStrategy = 'retry'
        maxRetries    = 3
    }
    // Training and evaluation. A GPU is requested only with -profile gpu; the
    // same label runs on CPU otherwise.
    withLabel: 'process_gpu' {
        cpus   = { 7 }
        memory = { 48.GB * task.attempt }
        time   = { 3.h * task.attempt }
    }
    withLabel: 'process_short' {
        time   = { 30.min * task.attempt }
    }
    withLabel: 'process_export' {
        cpus   = { 8 }
        memory = { 48.GB * task.attempt }
        time   = { 90.min * task.attempt }
    }
}
