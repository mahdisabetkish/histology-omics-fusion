# Raw and intermediate data. Everything here is rebuilt by
# src.data.download / build_dataset / features and is far too large to track.
#
# The leading slash matters. A bare "data/" pattern matches a directory of that
# name at any depth, which would silently swallow docs/data/ as well: that is
# the entire dashboard payload, and the published site would load but show
# nothing. Same reasoning for the other anchored paths below.
/data/

# Training output. Checkpoints are large; the JSON summaries they produce are
# copied into docs/data/ by src.export_dashboard, and that is what the site reads.
/runs/
*.pt
*.pth

# docs/ is committed on purpose, GitHub Pages serves it directly.

# Local working notes, not part of the project.
human.txt

# Regenerated by scripts/make_report.py; the README carries the same tables.
results_tables.md

# Scheduler output and the torchvision weight cache.
/logs/
/.torch/
slurm-*.out

# Scratch copies of the dashboard used while developing it.
/docs_probe/

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/
env/

.vscode/
.idea/
.DS_Store
Thumbs.db

# Nextflow work directory, run logs and default output directories.
/work/
/.nextflow/
.nextflow.log*
/results/
/results-test/
