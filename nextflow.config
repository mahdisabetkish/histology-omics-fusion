/*
 * histology-omics-fusion: pipeline configuration
 *
 * Every parameter can be overridden on the command line (--epochs 10) or in a
 * params file (-params-file my_params.yaml). Profiles are combined with commas:
 *
 *   -profile docker,gpu
 *   -profile slurm,apptainer,gpu
 */

manifest {
    name            = 'mahdisabetkish/histology-omics-fusion'
    author          = 'Mahdi Sabet Kish'
    homePage        = 'https://github.com/mahdisabetkish/histology-omics-fusion'
    description     = 'Multimodal fusion of spatial transcriptomics and histology for cortical layer prediction, with self-supervised pretraining.'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.10.0'
    version         = '1.1.0'
}

params {
    // Input. Set one of these to skip the stages before it; leave both unset
    // to start from the download.
    raw                  = null     // directory laid out like data/raw/
    processed            = null     // model-ready directory, e.g. a previous <outdir>/processed

    // Run matrix
    pretraining          = "${projectDir}/assets/pretraining.csv"
    experiments          = "${projectDir}/assets/experiments.csv"

    // Data preparation
    patch_size           = 112
    n_hvg                = 3000
    min_spots            = 50

    // Training. Defaults reproduce the published results.
    epochs               = 30
    ssl_epochs           = 60
    ssl_batch_size       = 256
    seed                 = 0
    train_extra_args     = ''       // appended to every src.train / src.train_expression call
    ssl_extra_args       = ''       // appended to every src.pretrain_ssl call

    // Evaluation and export. The dashboard needs per-spot predictions on all
    // three splits.
    eval_splits          = 'test,val,train'
    export               = true

    // Hardware
    gpu                  = false
    container_repo       = 'docker.io/mahdisabetkish/histology-omics-fusion'
    cluster_options      = ''       // extra scheduler flags, e.g. '--account=abc123 --partition=gpu'
    max_cpus             = 16
    max_memory           = '64.GB'
    max_time             = '24.h'

    // Output
    outdir               = 'results'
    publish_dir_mode     = 'copy'
    save_processed       = true

    // Synthetic test data (-profile test)
    test                 = false
    test_spots           = 400
    test_genes           = 400
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    // No container: the current Python environment must already have the
    // dependencies (pip install -r requirements.txt, or conda env create).
    standard {
        process.executor = 'local'
    }

    conda {
        conda.enabled       = true
        conda.useMamba      = false
        process.conda       = "${projectDir}/environment.yml"
    }

    docker {
        docker.enabled      = true
        // The checkout is mounted read-only at /opt/pipeline so tasks run its
        // code, with the image supplying only the environment. The shared
        // memory size matters: DataLoader workers pass batches through
        // /dev/shm and Docker's 64 MB default is too small for image batches.
        // The image's entrypoint changes to /app before running a command,
        // which suits `docker run` by hand but not a Nextflow task, which has
        // to run in its own work directory.
        docker.runOptions   = "--entrypoint '' -u \$(id -u):\$(id -g) --shm-size=2g -v ${projectDir}:/opt/pipeline:ro"
        process.container   = "${params.container_repo}:cpu"
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.runOptions = "--bind ${projectDir}:/opt/pipeline:ro"
        process.container    = "docker://${params.container_repo}:cpu"
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.runOptions = "--bind ${projectDir}:/opt/pipeline:ro"
        process.container      = "docker://${params.container_repo}:cpu"
    }

    gpu {
        params.gpu = true
        process {
            withLabel: 'process_gpu' {
                container        = { workflow.containerEngine == 'docker'
                                         ? "${params.container_repo}:gpu"
                                         : "docker://${params.container_repo}:gpu" }
                containerOptions = { workflow.containerEngine == 'docker' ? '--gpus all' : '--nv' }
            }
        }
    }

    slurm {
        process.executor       = 'slurm'
        process.clusterOptions = { params.cluster_options ?: '' }
        executor {
            queueSize          = 50
            submitRateLimit    = '10 sec'
            pollInterval       = '30 sec'
        }
        process {
            withLabel: 'process_gpu' {
                clusterOptions = { "${params.gpu ? '--gres=gpu:1 ' : ''}${params.cluster_options ?: ''}".trim() }
            }
        }
    }

    test {
        includeConfig 'conf/test.config'
    }
}

// Keep each library's thread pool inside the task's CPU allocation. Without
// this, OpenBLAS and MKL size their pools to the whole node and oversubscribe
// badly when several tasks share one machine.
//
// PYTHONPATH lists the container mount first and the checkout second: inside a
// container the first exists, outside one only the second does, and both hold
// the same code.
env {
    PYTHONPATH           = "/opt/pipeline:${projectDir}"
    PYTHONUNBUFFERED     = '1'
    PYTHONDONTWRITEBYTECODE = '1'
    MPLCONFIGDIR         = '/tmp/matplotlib'
    NUMBA_CACHE_DIR      = '/tmp/numba'
}

process.beforeScript = { "export OMP_NUM_THREADS=${task.cpus} MKL_NUM_THREADS=${task.cpus} OPENBLAS_NUM_THREADS=${task.cpus}" }

// Execution reports. Each run overwrites the previous one; keep a copy of
// pipeline_info/ if you need the history.
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
    fields    = 'task_id,hash,name,status,exit,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/dag.html"
}
